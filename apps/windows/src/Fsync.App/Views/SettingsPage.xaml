<Page
    x:Class="Fsync.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fsync.App.Views">
    <Page.Resources>
        <!-- One card per section (General, Sync, Privacy, Storage, Account). -->
        <Style x:Key="SettingsCardStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="{StaticResource FsyncSpace12}" />
            <Setter Property="Padding" Value="{StaticResource FsyncCardPadding}" />
            <Setter Property="CornerRadius" Value="{StaticResource FsyncCornerCard}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Spacing="{StaticResource FsyncSpace16}" MaxWidth="560" HorizontalAlignment="Left" Padding="0,0,16,16">
            <!-- Ui.PageHeader("Preferences"), set in code (the footer nav item keeps "Settings"). -->
            <Border x:Name="HeaderHost" />
            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ClipSettings.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(ClipSettings.Error), Mode=OneWay}" />

            <TextBlock Text="General" Style="{StaticResource FsyncSectionTitleTextStyle}" />
            <StackPanel Style="{StaticResource SettingsCardStyle}">
                <ToggleSwitch x:Name="StartupToggle" Header="Start fsync when I sign in to Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                <ToggleSwitch Header="Add fsync to Explorer's Send to menu" IsOn="{x:Bind ClipSettings.SendToMenu, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock Text="Sync" Style="{StaticResource FsyncSectionTitleTextStyle}" />
            <StackPanel Style="{StaticResource SettingsCardStyle}">
                <ToggleSwitch Header="Send my clipboard only when I ask (manual mode)" IsOn="{x:Bind ClipSettings.ManualMode, Mode=TwoWay}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FsyncCaptionTextStyle}"
                           Text="Manual mode: Win+Alt+C sends the clipboard, Win+Alt+V pastes the latest clip from another device. (Not Ctrl+Alt: that is AltGr on many keyboards.)" />
                <ToggleSwitch Header="Keyboard shortcuts (Win+Alt+C, Win+Alt+V)" IsOn="{x:Bind ClipSettings.Hotkeys, Mode=TwoWay}" />
                <ToggleSwitch Header="Download copied files before pasting (compatibility)" IsOn="{x:Bind ClipSettings.EagerFiles, Mode=TwoWay}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FsyncCaptionTextStyle}"
                           Text="Off: files copied on another device stream in when you paste in Explorer. On: they are downloaded first, for apps that need real files." />
                <ToggleSwitch Header="Save files sent to this PC without asking" IsOn="{x:Bind ClipSettings.AutoAcceptFiles, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock Text="Privacy" Style="{StaticResource FsyncSectionTitleTextStyle}" />
            <StackPanel Style="{StaticResource SettingsCardStyle}">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FsyncCaptionTextStyle}"
                           Text="Never sync what these apps copy (program names, one per line). Content marked private by an app (password managers) is always skipped." />
                <TextBox Header="Apps to ignore" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                         Text="{x:Bind ClipSettings.Denylist, Mode=TwoWay}" />
                <Button Content="Restore the default list" Command="{x:Bind ClipSettings.ResetDenylistCommand}" />
            </StackPanel>

            <TextBlock Text="Storage" Style="{StaticResource FsyncSectionTitleTextStyle}" />
            <StackPanel Style="{StaticResource SettingsCardStyle}">
                <NumberBox Header="Keep history for (days)" Minimum="1" Maximum="3650" SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ClipSettings.RetentionDays, Mode=TwoWay}" />
                <NumberBox Header="History size limit (GiB)" Minimum="0.01" Maximum="1000" SmallChange="0.5" SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ClipSettings.RetentionGb, Mode=TwoWay}" />
                <NumberBox Header="Largest clip to sync (MiB)" Minimum="1" Maximum="4096" SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ClipSettings.MaxClipMb, Mode=TwoWay}" />
            </StackPanel>

            <!-- Save applies General (Send to), Sync, Privacy and Storage; the startup toggle applies at once. -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource FsyncSpace8}">
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ClipSettings.SaveCommand}" />
                <TextBlock Text="{x:Bind ClipSettings.Saved, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Account" Style="{StaticResource FsyncSectionTitleTextStyle}" />
            <StackPanel Style="{StaticResource SettingsCardStyle}">
                <TextBlock Text="{x:Bind ViewModel.Email}" IsTextSelectionEnabled="True" Style="{StaticResource FsyncBodyTextStyle}" />
                <StackPanel Spacing="{StaticResource FsyncSpace4}">
                    <TextBlock Text="This PC" Style="{StaticResource FsyncSectionTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DeviceName}" Style="{StaticResource FsyncBodyTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.NodeId}" Style="{StaticResource FsyncCaptionTextStyle}" FontFamily="Consolas"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
                <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                         Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />
                <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind RecoveryError, Mode=OneWay}"
                         Visibility="{x:Bind local:Ui.ShowIf(RecoveryError), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FsyncSpace8}">
                    <Button Content="Sign out" Click="OnSignOut" />
                    <Button Content="Reset account..." Click="OnResetAccount"
                            ToolTipService.ToolTip="Make this PC the only trusted device on your account" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
