<Page
    x:Class="Fsync.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fsync.App.Views">
    <StackPanel Spacing="16" MaxWidth="400" HorizontalAlignment="Left">
        <TextBlock Text="Sign in to fsync" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.When(ViewModel.Step, 'Email'), Mode=OneWay}">
            <TextBlock TextWrapping="Wrap" Text="Enter your email. We send you a one-time code; no password needed." />
            <TextBox x:Name="EmailBox" Header="Email" PlaceholderText="you@example.com" InputScope="EmailSmtpAddress"
                     Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Send code" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SendCodeCommand}" />
        </StackPanel>

        <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.When(ViewModel.Step, 'Code'), Mode=OneWay}">
            <TextBlock TextWrapping="Wrap">
                <Run Text="We sent a code to" /> <Run Text="{x:Bind ViewModel.Email, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
            </TextBlock>
            <TextBox x:Name="CodeBox" Header="Code" InputScope="Number" MaxLength="12"
                     Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Sign in" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.VerifyCommand}" />
                <Button Content="Use another email" Command="{x:Bind ViewModel.BackCommand}" />
            </StackPanel>
        </StackPanel>

        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.Show(ViewModel.IsBusy), Mode=OneWay}" />
        <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />
    </StackPanel>
</Page>
