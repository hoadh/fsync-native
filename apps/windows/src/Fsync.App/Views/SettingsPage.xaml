<Page
    x:Class="Fsync.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fsync.App.Views">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Left" Padding="0,0,16,16">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ClipSettings.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(ClipSettings.Error), Mode=OneWay}" />

            <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ToggleSwitch Header="Send my clipboard only when I ask (manual mode)" IsOn="{x:Bind ClipSettings.ManualMode, Mode=TwoWay}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Manual mode: Win+Alt+C sends the clipboard, Win+Alt+V pastes the latest clip from another device. (Not Ctrl+Alt: that is AltGr on many keyboards.)" />
            <ToggleSwitch Header="Keyboard shortcuts (Win+Alt+C, Win+Alt+V)" IsOn="{x:Bind ClipSettings.Hotkeys, Mode=TwoWay}" />
            <ToggleSwitch Header="Add fsync to Explorer's Send to menu" IsOn="{x:Bind ClipSettings.SendToMenu, Mode=TwoWay}" />
            <ToggleSwitch Header="Download copied files before pasting (compatibility)" IsOn="{x:Bind ClipSettings.EagerFiles, Mode=TwoWay}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Off: files copied on another device stream in when you paste in Explorer. On: they are downloaded first, for apps that need real files." />
            <ToggleSwitch x:Name="StartupToggle" Header="Start fsync when I sign in to Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />

            <TextBlock Text="Privacy" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Never sync what these apps copy (program names, one per line). Content marked private by an app (password managers) is always skipped." />
            <TextBox Header="Apps to ignore" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                     Text="{x:Bind ClipSettings.Denylist, Mode=TwoWay}" />
            <Button Content="Restore the default list" Command="{x:Bind ClipSettings.ResetDenylistCommand}" />

            <TextBlock Text="Storage" Style="{StaticResource SubtitleTextBlockStyle}" />
            <NumberBox Header="Keep history for (days)" Minimum="1" Maximum="3650" SpinButtonPlacementMode="Compact"
                       Value="{x:Bind ClipSettings.RetentionDays, Mode=TwoWay}" />
            <NumberBox Header="History size limit (GiB)" Minimum="0.01" Maximum="1000" SmallChange="0.5" SpinButtonPlacementMode="Compact"
                       Value="{x:Bind ClipSettings.RetentionGb, Mode=TwoWay}" />
            <NumberBox Header="Largest clip to sync (MiB)" Minimum="1" Maximum="4096" SpinButtonPlacementMode="Compact"
                       Value="{x:Bind ClipSettings.MaxClipMb, Mode=TwoWay}" />
            <ToggleSwitch Header="Save files sent to this PC without asking" IsOn="{x:Bind ClipSettings.AutoAcceptFiles, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ClipSettings.SaveCommand}" />
                <TextBlock Text="{x:Bind ClipSettings.Saved, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Email}" IsTextSelectionEnabled="True" />
            <StackPanel Spacing="4">
                <TextBlock Text="This PC" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.DeviceName}" />
                <TextBlock Text="{x:Bind ViewModel.NodeId}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />
            <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
