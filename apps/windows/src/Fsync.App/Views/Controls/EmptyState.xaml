<UserControl
    x:Class="Fsync.App.Views.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fsync.App.Views">
    <!-- Empty list placeholder (spec state matrix "Empty"): glyph, title, body, optional action. -->
    <StackPanel Spacing="{StaticResource FsyncSpace8}" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="360" Padding="{StaticResource FsyncCardPadding}">
        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="40" HorizontalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource FsyncSectionTitleTextStyle}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind Body, Mode=OneWay}" Style="{StaticResource FsyncCaptionTextStyle}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Visibility="{x:Bind local:Ui.ShowIf(Body), Mode=OneWay}" />
        <Button Content="{x:Bind ActionText, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,4,0,0"
                Visibility="{x:Bind local:Ui.ShowIf(ActionText), Mode=OneWay}" Click="OnActionClick" />
    </StackPanel>
</UserControl>
