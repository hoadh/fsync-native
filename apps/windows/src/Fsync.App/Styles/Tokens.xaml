<!--
  fsync design tokens (desktop UI redesign spec). Merged in App.xaml after XamlControlsResources.
  Pages use {StaticResource} for sizes and styles; colours inside the styles are {ThemeResource}.

  Spacing (x:Double):     FsyncSpace4, FsyncSpace8, FsyncSpace12, FsyncSpace16, FsyncSpace24
  Spacing (Thickness):    FsyncPagePadding (24,16,24,24), FsyncCardPadding (16),
                          FsyncBannerItemMargin (0,12,0,0: each InfoBar added to MainWindow.BannerHost)
  Corner radius:          FsyncCornerSmall (4), FsyncCornerCard (8)
  Type ramp (TextBlock):  FsyncPageTitleTextStyle, FsyncPageSubtitleTextStyle, FsyncSectionTitleTextStyle,
                          FsyncBodyTextStyle, FsyncCaptionTextStyle
  Status dots (Ellipse):  FsyncStatusGoodDotStyle (LAN / relay), FsyncStatusWarningDotStyle (online, not connected),
                          FsyncStatusBadDotStyle (offline), FsyncStatusNeutralDotStyle (this PC);
                          key = "FsyncStatus{StatusKind}DotStyle", picked by Ui.StatusDotStyle(kind)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="FsyncSpace4">4</x:Double>
    <x:Double x:Key="FsyncSpace8">8</x:Double>
    <x:Double x:Key="FsyncSpace12">12</x:Double>
    <x:Double x:Key="FsyncSpace16">16</x:Double>
    <x:Double x:Key="FsyncSpace24">24</x:Double>

    <Thickness x:Key="FsyncPagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="FsyncCardPadding">16</Thickness>
    <Thickness x:Key="FsyncBannerItemMargin">0,12,0,0</Thickness>

    <CornerRadius x:Key="FsyncCornerSmall">4</CornerRadius>
    <CornerRadius x:Key="FsyncCornerCard">8</CornerRadius>

    <Style x:Key="FsyncPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
    <Style x:Key="FsyncPageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="FsyncSectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    <Style x:Key="FsyncBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
    <Style x:Key="FsyncCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
      Status dots, one style per StatusKind (canonical status vocabulary, see Ui.StatusDotStyle).
      Colours follow the spec icon map: connected (LAN / relay) = success, online but not
      connected = caution, offline and this PC = neutral. The fills are {ThemeResource} references
      to the system brushes, so Light, Dark and high contrast are resolved by the framework and
      follow theme changes; no theme dictionaries of our own.
    -->
    <Style x:Key="FsyncStatusDotBaseStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FsyncStatusGoodDotStyle" TargetType="Ellipse" BasedOn="{StaticResource FsyncStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="FsyncStatusWarningDotStyle" TargetType="Ellipse" BasedOn="{StaticResource FsyncStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="FsyncStatusBadDotStyle" TargetType="Ellipse" BasedOn="{StaticResource FsyncStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorNeutralBrush}" />
    </Style>
    <Style x:Key="FsyncStatusNeutralDotStyle" TargetType="Ellipse" BasedOn="{StaticResource FsyncStatusDotBaseStyle}">
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorNeutralBrush}" />
    </Style>
</ResourceDictionary>
