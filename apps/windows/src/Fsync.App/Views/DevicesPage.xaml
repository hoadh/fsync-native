<Page
    x:Class="Fsync.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fsync.App.ViewModels"
    xmlns:local="using:Fsync.App.Views">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Your devices" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Message="{x:Bind Bridge.StatusMessage, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(Bridge.StatusMessage), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Click="OnRetry" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />
        </StackPanel>
        <ListView x:Name="List" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Devices}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceItem">
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind local:Ui.StatusBrush(Kind)}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind PlatformText}" /><Run Text=" · " /><Run Text="{x:Bind StatusText}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind LastSeenText}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind local:Ui.ShowIf(LastSeenText)}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Remove" Visibility="{x:Bind local:Ui.Show(CanRemove)}"
                                Tag="{x:Bind}" Click="OnRemove" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
