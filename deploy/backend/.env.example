# Copy to .env (never commit .env). No real secrets here.

# Postgres (used by compose for both the db container and the backend)
POSTGRES_USER=fsync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fsync

# Backend
# base64 of 32 random bytes:  openssl rand -base64 32
JWT_SIGNING_KEY=
BIND_ADDR=0.0.0.0:8080
# 1 = log OTP codes at debug level, allow ephemeral signing key. NEVER in production.
FSYNC_DEV_MODE=0
# Set to production on real deployments: refuses FSYNC_DEV_MODE=1
FSYNC_ENV=production
# Number of reverse proxies you control in front of the backend. 0 = use the socket peer address
# (correct when exposed directly). N > 0 = client IP is the Nth entry from the RIGHT of
# X-Forwarded-For (each proxy must APPEND the address it saw; never set N above the real count).
# Behind a proxy with 0 every client shares the proxy IP and per-IP limits become global.
TRUST_PROXY_HOPS=0
# Comma-separated CIDRs of those proxies (the peer address the backend sees, e.g. the docker
# network 172.16.0.0/12). X-Forwarded-For is ignored from any other peer. Required when hops > 0.
TRUSTED_PROXIES=
# Caps: unauthenticated presence sockets (total / per IP) and in-flight HTTP requests
MAX_UNAUTH_WS=1000
MAX_UNAUTH_WS_PER_IP=10
MAX_IN_FLIGHT=512
# Presence heartbeat timeout in seconds
PRESENCE_TIMEOUT_SECS=60
RUST_LOG=info
