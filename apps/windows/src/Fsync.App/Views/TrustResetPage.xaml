<Page
    x:Class="Fsync.App.Views.TrustResetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fsync.App.Views">
    <!-- Trust gate: the only page while a trust reset waits (MainWindow.TrustGate). Names are sanitized. -->
    <ScrollViewer>
        <StackPanel Spacing="{StaticResource FsyncSpace12}" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Review a device list change" Style="{StaticResource FsyncPageTitleTextStyle}"
                       AutomationProperties.HeadingLevel="Level1" />

            <InfoBar Severity="Success" IsOpen="True" IsClosable="False" AutomationProperties.AutomationId="TrustOutcome"
                     Message="{x:Bind OutcomeText(ViewModel.Outcome), Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.When(ViewModel.Outcome, 'Trusted,Declined'), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Continue" Click="OnContinue" AutomationProperties.AutomationId="TrustContinueButton" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="True" IsClosable="False"
                     Severity="{x:Bind MessageSeverity(ViewModel.MessageIsNotice), Mode=OneWay}"
                     Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Message), Mode=OneWay}" />

            <StackPanel Spacing="{StaticResource FsyncSpace12}" Visibility="{x:Bind local:Ui.Show(ViewModel.HasPending), Mode=OneWay}">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource FsyncBodyTextStyle}"
                           Text="The list of trusted devices of your account was reset on another device. Confirm only if you did this yourself. If you did not, keep your current devices." />
                <TextBlock Text="{x:Bind NewListTitle(ViewModel.Current), Mode=OneWay}" Style="{StaticResource FsyncSectionTitleTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayNames, Mode=OneWay}" AutomationProperties.AutomationId="TrustDeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Style="{StaticResource FsyncBodyTextStyle}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource FsyncSpace8}">
                    <!-- Keep gets the initial focus, so Return keeps the current devices. -->
                    <Button x:Name="KeepButton" Content="Keep current devices" Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind Idle(ViewModel.IsBusy), Mode=OneWay}" Click="OnKeep"
                            AutomationProperties.AutomationId="TrustKeepButton" />
                    <Button Content="Confirm reset..." IsEnabled="{x:Bind Idle(ViewModel.IsBusy), Mode=OneWay}" Click="OnConfirm"
                            AutomationProperties.AutomationId="TrustConfirmButton" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
