<!--
  fsync design tokens (desktop UI redesign spec). Merged in App.xaml after XamlControlsResources.
  Pages use {StaticResource} for sizes and styles, {ThemeResource} for brushes.

  Spacing (x:Double):     FsyncSpace4, FsyncSpace8, FsyncSpace12, FsyncSpace16, FsyncSpace24
  Spacing (Thickness):    FsyncPagePadding (24,16,24,24), FsyncCardPadding (16),
                          FsyncBannerItemMargin (0,12,0,0: each InfoBar added to MainWindow.BannerHost)
  Corner radius:          FsyncCornerSmall (4), FsyncCornerCard (8)
  Type ramp (TextBlock):  FsyncPageTitleTextStyle, FsyncPageSubtitleTextStyle, FsyncSectionTitleTextStyle,
                          FsyncBodyTextStyle, FsyncCaptionTextStyle
  Status brushes:         FsyncStatusOnlineBrush (online, not connected), FsyncStatusLanBrush, FsyncStatusRelayBrush,
                          FsyncStatusOfflineBrush, FsyncStatusAttentionBrush
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="FsyncSpace4">4</x:Double>
    <x:Double x:Key="FsyncSpace8">8</x:Double>
    <x:Double x:Key="FsyncSpace12">12</x:Double>
    <x:Double x:Key="FsyncSpace16">16</x:Double>
    <x:Double x:Key="FsyncSpace24">24</x:Double>

    <Thickness x:Key="FsyncPagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="FsyncCardPadding">16</Thickness>
    <Thickness x:Key="FsyncBannerItemMargin">0,12,0,0</Thickness>

    <CornerRadius x:Key="FsyncCornerSmall">4</CornerRadius>
    <CornerRadius x:Key="FsyncCornerCard">8</CornerRadius>

    <Style x:Key="FsyncPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
    <Style x:Key="FsyncPageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="FsyncSectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
    <Style x:Key="FsyncBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
    <Style x:Key="FsyncCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Status colours follow the spec icon map: good = success, online not connected = caution, offline = neutral. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="FsyncStatusOnlineBrush" Color="{ThemeResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="FsyncStatusLanBrush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="FsyncStatusRelayBrush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="FsyncStatusOfflineBrush" Color="{ThemeResource SystemFillColorNeutral}" />
            <SolidColorBrush x:Key="FsyncStatusAttentionBrush" Color="{ThemeResource SystemFillColorCaution}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FsyncStatusOnlineBrush" Color="{ThemeResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="FsyncStatusLanBrush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="FsyncStatusRelayBrush" Color="{ThemeResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="FsyncStatusOfflineBrush" Color="{ThemeResource SystemFillColorNeutral}" />
            <SolidColorBrush x:Key="FsyncStatusAttentionBrush" Color="{ThemeResource SystemFillColorCaution}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FsyncStatusOnlineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FsyncStatusLanBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FsyncStatusRelayBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FsyncStatusOfflineBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="FsyncStatusAttentionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
