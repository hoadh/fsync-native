    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Main is [STAThread]; the clipboard owner lives on a dedicated StaThread. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClipSpike.Core/ClipSpike.Core.csproj" />
  </ItemGroup>
</Project>
