<Page
    x:Class="Fsync.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fsync.App.ViewModels"
    xmlns:local="using:Fsync.App.Views">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Clipboard history" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" Content="Clear history..." Click="OnClear" />
        </Grid>
        <TextBox Grid.Row="1" x:Name="Search" PlaceholderText="Search" Header="Search"
                 Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Status), Mode=OneWay}" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                    <Grid ColumnSpacing="8" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Meta}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Content="Copy" IsEnabled="{x:Bind CanCopy}" Tag="{x:Bind}" Click="OnCopy"
                                    ToolTipService.ToolTip="Put it back on the clipboard" />
                            <ToggleButton Content="Pin" IsChecked="{x:Bind Pinned, Mode=OneWay}" Tag="{x:Bind}" Click="OnPin"
                                          ToolTipService.ToolTip="Pinned items are kept when the history is trimmed" />
                            <Button Content="Delete" Tag="{x:Bind}" Click="OnDelete" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Grid.Row="4" Content="Load more" Command="{x:Bind ViewModel.LoadMoreCommand}"
                Visibility="{x:Bind local:Ui.Show(ViewModel.HasMore), Mode=OneWay}" />
    </Grid>
</Page>
