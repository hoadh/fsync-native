# Copy to .env (never commit it) or generate one: deploy/scripts/gen-env.sh > .env
# No real secrets here.

# Public hostnames (used by the relay for QAD cert lookup and by smoke checks). TLS is terminated
# by the Caddy in front of the stack (see Caddyfile / README).
API_HOST=api-fsync.10z.one
RELAY_HOST=relay-fsync.10z.one
# Loopback ports the Caddy upstreams point at.
BACKEND_PORT=18080
RELAY_HTTP_PORT=18081

# Postgres
POSTGRES_USER=fsync
POSTGRES_PASSWORD=
POSTGRES_DB=fsync

# Backend. JWT_SIGNING_KEY = base64 of 32 random bytes:  openssl rand -base64 32
JWT_SIGNING_KEY=
# production refuses FSYNC_DEV_MODE=1. No email provider is wired yet, so until one is, OTP codes
# are only visible with FSYNC_ENV=staging + FSYNC_DEV_MODE=1 + RUST_LOG=fsync_backend=debug,info
# (logs the code; fine for a private staging, never for real users).
FSYNC_ENV=production
FSYNC_DEV_MODE=0
RUST_LOG=info
# Caddy is the single proxy in front of the backend (defaults, usually leave as is). api-fsync
# must be DNS-only (grey cloud); alternative with Cloudflare: TRUST_PROXY_HOPS=2 and Caddy
# `trusted_proxies` with the Cloudflare ranges.
TRUST_PROXY_HOPS=1
# TRUSTED_PROXIES defaults to FSYNC_SUBNET + 127.0.0.0/8 (see compose.yml); only override both together.
#FSYNC_SUBNET=172.29.0.0/24
MAX_UNAUTH_WS=1000
MAX_UNAUTH_WS_PER_IP=10
MAX_IN_FLIGHT=512
PRESENCE_TIMEOUT_SECS=60

# Relay. Optional per-client receive cap (bytes/s); empty = unlimited. Watch the Lightsail
# monthly transfer allowance.
RELAY_RX_BYTES_PER_SEC=
RELAY_RUST_LOG=info
# QUIC address discovery (better NAT traversal): 1 needs a firewall rule for udp/7842, a bind on
# all interfaces and read access to the Caddy-managed relay certificate.
RELAY_QAD=0
RELAY_QUIC_BIND=127.0.0.1
RELAY_QUIC_PORT=7842
# Only read when RELAY_QAD=1: the relay hostname's cert dir (never Caddy's whole data dir) and
# root, because Caddy's key is root-only 0600.
#RELAY_CERT_DIR=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/relay-fsync.10z.one
#RELAY_USER=0
