<Page
    x:Class="Fsync.App.Views.PairingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fsync.App.Views">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="460" HorizontalAlignment="Left">
            <TextBlock Text="Pair a device" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- New device: show a code or QR for an existing device. -->
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.Show(IsNewDevice), Mode=OneWay}">
                <TextBlock TextWrapping="Wrap" Text="This PC is not paired yet. On a device that already uses fsync, choose Pair a device and enter this code." />
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Ui.When(ViewModel.Stage, 'Idle,Failed,Completed'), Mode=OneWay}">
                    <Button Content="Show a code" Style="{StaticResource AccentButtonStyle}" Click="OnOfferCode" />
                    <Button Content="Show a QR code" Click="OnOfferQr" />
                </StackPanel>
            </StackPanel>

            <!-- Existing device: enter the new device's code. -->
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.Show(IsExistingDevice), Mode=OneWay}">
                <TextBlock TextWrapping="Wrap" Text="On the new device, sign in with the same email and choose Show a code. Enter it here." />
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Ui.When(ViewModel.Stage, 'Idle,Failed,Completed'), Mode=OneWay}">
                    <TextBox x:Name="JoinBox" Width="260" PlaceholderText="Code or fsync://pair link"
                             Text="{x:Bind ViewModel.JoinInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Pair" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.JoinCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Offering -->
            <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.When(ViewModel.Stage, 'Offering'), Mode=OneWay}">
                <TextBlock x:Name="CodeText" Text="{x:Bind ViewModel.OfferCode, Mode=OneWay}" FontSize="36" FontWeight="SemiBold"
                           IsTextSelectionEnabled="True" Visibility="{x:Bind local:Ui.ShowIf(ViewModel.OfferCode), Mode=OneWay}" />
                <Image x:Name="QrImage" Width="240" Height="240" HorizontalAlignment="Left"
                       Visibility="{x:Bind local:Ui.ShowIfAny(ViewModel.QrPng), Mode=OneWay}" />
                <TextBlock Text="{x:Bind local:Ui.Expires(ViewModel.ExpiresAt), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Waiting for the other device..." />
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.When(ViewModel.Stage, 'Joining'), Mode=OneWay}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="Connecting to the new device..." />
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>

            <!-- SAS: both sides must see the same words. -->
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.When(ViewModel.Stage, 'ConfirmSas'), Mode=OneWay}">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Pairing with" /> <Run Text="{x:Bind ViewModel.PeerName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="(" /><Run Text="{x:Bind ViewModel.PeerPlatform, Mode=OneWay}" /><Run Text=")." />
                    <Run Text="Check that the other device shows exactly these words:" />
                </TextBlock>
                <TextBlock x:Name="SasText" Text="{x:Bind ViewModel.SasWords, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AcceptButton" Content="The words match" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AcceptCommand}" />
                    <Button Content="They don't match" Command="{x:Bind ViewModel.RejectCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.When(ViewModel.Stage, 'WaitingForOther'), Mode=OneWay}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="Waiting for the other device to confirm..." />
            </StackPanel>

            <InfoBar Severity="Success" IsOpen="True" IsClosable="False" Title="Paired"
                     Message="The devices now trust each other."
                     Visibility="{x:Bind local:Ui.When(ViewModel.Stage, 'Completed'), Mode=OneWay}" />
            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Title="Pairing failed" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.When(ViewModel.Stage, 'Failed'), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
