<Window
    x:Class="Fsync.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="fsync">
    <Grid>
        <NavigationView x:Name="Nav" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Devices" Tag="devices" Icon="AllApps" />
                <NavigationViewItem Content="History" Tag="history" Icon="Paste" />
                <NavigationViewItem Content="Files" Tag="files" Icon="Download" />
                <NavigationViewItem Content="Pair a device" Tag="pairing" Icon="Add" />
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Padding="24,16,24,24" />
        </NavigationView>

        <!-- Starting / failed states cover the navigation. -->
        <Grid x:Name="Overlay" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                <ProgressRing x:Name="Spinner" IsActive="True" />
                <TextBlock x:Name="OverlayText" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="ResetHistoryButton" Content="Start a new history on this PC" Visibility="Collapsed"
                        HorizontalAlignment="Center" Click="OnResetHistory" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
