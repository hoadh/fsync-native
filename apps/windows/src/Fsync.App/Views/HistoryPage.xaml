<Page
    x:Class="Fsync.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fsync.App.ViewModels"
    xmlns:controls="using:Fsync.App.Views.Controls"
    xmlns:local="using:Fsync.App.Views">
    <Grid RowSpacing="{StaticResource FsyncSpace12}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="{StaticResource FsyncSpace8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Ui.PageHeader("Clipboard history"), set in code. -->
            <Border x:Name="HeaderHost" />
            <Button Grid.Column="1" Content="Clear history..." Click="OnClear" VerticalAlignment="Top" />
        </Grid>
        <TextBox Grid.Row="1" x:Name="Search" PlaceholderText="Search" Header="Search"
                 Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Grid.Row="2" Spacing="{StaticResource FsyncSpace8}">
            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />
            <!-- Transient status ("Copied to the clipboard." etc.); the empty state covers "nothing here". -->
            <TextBlock Text="{x:Bind StatusCaption, Mode=OneWay}" Style="{StaticResource FsyncCaptionTextStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind local:Ui.ShowIf(StatusCaption), Mode=OneWay}" />
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                    <Grid ColumnSpacing="{StaticResource FsyncSpace8}" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Preview}" Style="{StaticResource FsyncBodyTextStyle}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Meta}" Style="{StaticResource FsyncCaptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource FsyncSpace4}" VerticalAlignment="Center">
                            <Button Content="Copy" IsEnabled="{x:Bind CanCopy}" Tag="{x:Bind}" Click="OnCopy"
                                    ToolTipService.ToolTip="Put it back on the clipboard" />
                            <ToggleButton Content="Pin" IsChecked="{x:Bind Pinned, Mode=OneWay}" Tag="{x:Bind}" Click="OnPin"
                                          ToolTipService.ToolTip="Pinned items are kept when the history is trimmed" />
                            <Button Content="Delete" Tag="{x:Bind}" Click="OnDelete" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <!-- No items after a load: nothing copied, or nothing for the search. Follows LoadedQuery
                     (search of the last finished load), not Query: no "No matches" while typing. -->
                <controls:EmptyState Margin="0,24,0,0" Glyph="{x:Bind controls:PageText.HistoryEmptyGlyph(ViewModel.LoadedQuery), Mode=OneWay}"
                                     Title="{x:Bind controls:PageText.HistoryEmptyTitle(ViewModel.LoadedQuery), Mode=OneWay}"
                                     Body="{x:Bind controls:PageText.HistoryEmptyBody(ViewModel.LoadedQuery), Mode=OneWay}"
                                     Visibility="{x:Bind local:Ui.Show(ShowEmpty), Mode=OneWay}" />
            </ListView.Footer>
        </ListView>
        <Button Grid.Row="4" Content="Load more" Command="{x:Bind ViewModel.LoadMoreCommand}"
                Visibility="{x:Bind local:Ui.Show(ViewModel.HasMore), Mode=OneWay}" />
    </Grid>
</Page>
