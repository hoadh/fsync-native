<Page
    x:Class="Fsync.App.Views.TransfersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fsync.App.ViewModels"
    xmlns:files="using:Fsync.App.Files"
    xmlns:local="using:Fsync.App.Views">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <TextBlock Text="Files" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowIf(ViewModel.Error), Mode=OneWay}" />

            <!-- "Send to > fsync" from Explorer: pick a device for the queued paths. -->
            <StackPanel x:Name="SendPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Send to which device?" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="SendWhat" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{x:Bind Targets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SendTarget">
                            <Button Content="{x:Bind Name}" Tag="{x:Bind}" Click="OnSendTo" Margin="0,0,0,4"
                                    ToolTipService.ToolTip="{x:Bind StatusText}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Cancel" Click="OnCancelSend" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.Show(HasOffers), Mode=OneWay}">
                <TextBlock Text="Waiting for you" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Offers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="files:IncomingOffer">
                            <Grid ColumnSpacing="8" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Save to Downloads" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" Click="OnAccept" />
                                <Button Grid.Column="2" Content="Decline" Tag="{x:Bind}" Click="OnDecline" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Transfers" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Grid.Column="1" Content="Clear finished" Command="{x:Bind ViewModel.ClearFinishedCommand}" />
            </Grid>
            <TextBlock Text="Drop files on a device in Devices, or use Send to > fsync in Explorer."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ListView ItemsSource="{x:Bind ViewModel.Transfers}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="files:TransferItem">
                        <Grid ColumnSpacing="8" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind local:Ui.Show(IsActive), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Cancel" Tag="{x:Bind}" Click="OnCancel" Visibility="{x:Bind local:Ui.Show(IsActive), Mode=OneWay}" />
                                <Button Content="Retry" Tag="{x:Bind}" Click="OnRetry" Visibility="{x:Bind local:Ui.Show(CanRetry), Mode=OneWay}" />
                                <Button Content="Show" Tag="{x:Bind}" Click="OnShow" Visibility="{x:Bind local:Ui.ShowIf(Path), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
