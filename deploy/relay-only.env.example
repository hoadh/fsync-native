# Relay-only host (deploy.sh --relay-only). Copy to .env or pass with --env-file. No secrets: the
# relay needs none. TLS is the host Caddy's job (see README "Relay-only host").
RELAY_HOST=relay-sg-fsync.10z.one
# Loopback port the Caddy upstream points at.
RELAY_HTTP_PORT=18081
# Optional per-client receive cap (bytes/s); empty = unlimited. Watch the Lightsail monthly transfer.
RELAY_RX_BYTES_PER_SEC=
RELAY_RUST_LOG=info
# QUIC address discovery, off by default. To enable see README "Enabling QUIC address discovery"
# (sudo scripts/sync-relay-cert.sh <host> + cron): RELAY_QAD=1, RELAY_QUIC_BIND=0.0.0.0, RELAY_CERT_DIR.
RELAY_QAD=0
RELAY_QUIC_BIND=127.0.0.1
RELAY_QUIC_PORT=7842
#RELAY_CERT_DIR=/opt/fsync/relay-cert
